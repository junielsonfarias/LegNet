# Placeholders PNG gerados automaticamente pelo script.
# Prints reais (capturados pelo user) devem ser commitados manualmente
# com git add -f docs/manual/images/NOME.png (forcando).
# O manifest rastreia quais arquivos sao placeholders vs reais.
docs/manual/images/*.png
docs/manual/images/.placeholders-manifest.json
!docs/manual/images/.gitkeep

# Estado de auth do Playwright (contem cookie de sessao — nunca commitar)
docs/manual/.auth-state.json

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

